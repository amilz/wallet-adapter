{
    "name": "@solana/wallet-adapter-kit",
    "version": "0.1.0",
    "description": "Wallet-adapter-style hooks and UI for @solana/web3.js v3 apps, built natively on @solana/kit",
    "author": "Solana Maintainers <maintainers@solana.foundation>",
    "repository": "https://github.com/anza-xyz/wallet-adapter",
    "license": "Apache-2.0",
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "lib",
        "src",
        "styles.css",
        "LICENSE"
    ],
    "engines": {
        "node": ">=20"
    },
    "type": "module",
    "sideEffects": [
        "*.css"
    ],
    "module": "./lib/esm/index.js",
    "types": "./lib/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "import": "./lib/esm/index.js"
        },
        "./web3js": {
            "types": "./lib/types/web3js/index.d.ts",
            "import": "./lib/esm/web3js/index.js"
        },
        "./styles.css": "./styles.css"
    },
    "scripts": {
        "build": "tsc --build --verbose",
        "clean": "shx mkdir -p lib && shx rm -rf lib",
        "lint": "prettier --check 'src/{*,**/*}.{ts,tsx,js,jsx,json}' && eslint",
        "test": "NODE_OPTIONS=--experimental-vm-modules jest"
    },
    "peerDependencies": {
        "@solana/kit": "^7.0.0",
        "@solana/kit-plugin-wallet": "^0.14.0",
        "@solana/react": "^7.0.0",
        "@solana/web3.js": "^3.0.0-rc.2",
        "react": "*",
        "react-dom": "*"
    },
    "peerDependenciesMeta": {
        "@solana/web3.js": {
            "optional": true
        }
    },
    "dependencies": {
        "@solana/kit-plugin-rpc": "^0.13.0"
    },
    "devDependencies": {
        "@solana/kit": "^7.0.0",
        "@solana/kit-plugin-wallet": "^0.14.0",
        "@solana/react": "^7.0.0",
        "@testing-library/react": "^16.3.2",
        "@types/jest": "^29.5.14",
        "@types/react": "^19.1.6",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "shx": "^0.4.0",
        "ts-jest": "^29.3.4",
        "web3js-v3": "npm:@solana/web3.js@3.0.0-rc.2"
    }
}

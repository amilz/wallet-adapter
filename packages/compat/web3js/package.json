{
    "name": "@solana/web3-compat-wallet-adapter",
    "version": "0.1.0",
    "description": "Use wallet-adapter wallets with @solana/web3.js v3 via a Kit transaction signer",
    "author": "Solana Maintainers <maintainers@solana.foundation>",
    "repository": "https://github.com/anza-xyz/wallet-adapter",
    "license": "Apache-2.0",
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "lib",
        "src",
        "LICENSE"
    ],
    "engines": {
        "node": ">=20"
    },
    "type": "module",
    "sideEffects": false,
    "main": "./lib/cjs/index.js",
    "module": "./lib/esm/index.js",
    "types": "./lib/types/index.d.ts",
    "exports": {
        "require": "./lib/cjs/index.js",
        "import": "./lib/esm/index.js",
        "types": "./lib/types/index.d.ts"
    },
    "scripts": {
        "build": "tsc --build --verbose && pnpm run package",
        "clean": "shx mkdir -p lib && shx rm -rf lib",
        "lint": "prettier --check 'src/{*,**/*}.{ts,tsx,js,jsx,json}' && eslint",
        "package": "shx mkdir -p lib/cjs && shx echo '{ \"type\": \"commonjs\" }' > lib/cjs/package.json",
        "test": "jest"
    },
    "peerDependencies": {
        "@solana/wallet-adapter-base": "^0.9.27",
        "@solana/wallet-adapter-react": "^0.15.39",
        "react": "*"
    },
    "dependencies": {
        "@solana/addresses": "^6.8.0",
        "@solana/signers": "^6.8.0",
        "@solana/transactions": "^6.8.0",
        "@solana/wallet-standard-features": "^1.3.0",
        "@wallet-standard/base": "^1.1.0"
    },
    "devDependencies": {
        "@solana/kit": "^6.8.0",
        "@solana/wallet-adapter-base": "workspace:^",
        "@solana/wallet-adapter-react": "workspace:^",
        "@testing-library/react": "^16.3.2",
        "@types/jest": "^29.5.14",
        "@types/react": "^19.1.6",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "shx": "^0.4.0",
        "ts-jest": "^29.3.4",
        "web3js-v3": "npm:@solana/web3.js@3.0.0-rc.1"
    }
}
